<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the OS's Dark Mode setting is off. The app is dark-only, so
         the launch window uses the dark background in both modes to avoid a
         white flash before the first Flutter frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window background behind the running Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/appBackground</item>
    </style>
</resources>
